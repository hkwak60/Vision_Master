<UserControl x:Class="KickoutMonitor.App.DlngReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F5F7"
             Focusable="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackground}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Back" Click="BackButton_Click"
                        VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="DLNG Review" Foreground="White"
                               FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Cropped DLNG / C-NG / QNG / NG review"
                               Foreground="#C8D1DA" FontSize="12"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding PositionText}" Foreground="White"
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#E1E5E9">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
        </StatusBar>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="105"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" Padding="8" Margin="0,0,0,10">
                <Grid x:Name="ReviewToolbar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="1.5*" MinWidth="150"/>
                        <ColumnDefinition Width="1.5*" MinWidth="150"/>
                        <ColumnDefinition Width="*" MinWidth="86"/>
                        <ColumnDefinition Width="*" MinWidth="94"/>
                        <ColumnDefinition Width="*" MinWidth="94"/>
                        <ColumnDefinition Width="*" MinWidth="112"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Text="Lines / ±" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBlock Grid.Column="1" Text="Models" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBlock Grid.Column="2" Text="Start date / time" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBlock Grid.Column="3" Text="End date / time" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBlock Grid.Column="5" Text="Report start" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <TextBlock Grid.Column="6" Text="Report end" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,6,0">

                        <ListBox ItemsSource="{Binding MachineOptions}" Height="56" Padding="0"
                                 BorderBrush="{StaticResource PanelBorder}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" Rows="2"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Content="{Binding Label}"
                                              Margin="0,1" FontSize="11"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,6,0">

                        <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                Padding="2" Height="56">
                            <ScrollViewer  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                                <CheckBox Content="All"
                                          IsChecked="{Binding AllModelsSelected}"
                                          FontWeight="SemiBold"
                                          Margin="2,1" MinWidth="54"/>
                                <ItemsControl ItemsSource="{Binding ModelOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      Content="{Binding Name}"
                                                      Margin="2,1" MinWidth="72"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel></ScrollViewer>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Column="2" Grid.Row="1" VerticalAlignment="Top" Margin="0,0,6,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                        <DatePicker SelectedDate="{Binding StartDate}" Height="34" FontSize="12"/>
                        <TextBox Grid.Column="1" Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="2,0"
                                 FontSize="12" Margin="4,0,0,0" VerticalContentAlignment="Center" ToolTip="Queue time: HH:mm (24-hour)"/>
                    </Grid>
                    <Grid Grid.Column="3" Grid.Row="1" VerticalAlignment="Top" Margin="0,0,6,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                        <DatePicker SelectedDate="{Binding EndDate}" Height="34" FontSize="12"/>
                        <TextBox Grid.Column="1" Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="2,0"
                                 FontSize="12" Margin="4,0,0,0" VerticalContentAlignment="Center" ToolTip="Queue time: HH:mm (24-hour)"/>
                    </Grid>
                    <Button Grid.Column="4" Grid.Row="1" Content="Load Queue" Command="{Binding LoadCommand}"
                            ToolTip="Load DLNG Queue" FontSize="12" Padding="3,2" MinHeight="34" Height="34" VerticalAlignment="Top" Margin="0,0,6,0"/>
                    <DatePicker Grid.Column="5" Grid.Row="1" SelectedDate="{Binding ReportDate}" Height="34" FontSize="12"
                                VerticalAlignment="Top" Margin="0,0,6,0"/>
                    <DatePicker Grid.Column="6" Grid.Row="1" SelectedDate="{Binding ReportEndDate}" Height="34" FontSize="12"
                                VerticalAlignment="Top" Margin="0,0,6,0"/>
                    <Button x:Name="GenerateReportButton" Grid.Column="7" Grid.Row="1" Content="Generate Summary"
                            Command="{Binding GenerateReportCommand}" ToolTip="Generate DLNG Report" FontSize="12" Padding="3,2" MinHeight="34"
                            Height="34" VerticalAlignment="Top" Margin="0,0,6,0"/>

                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#18212A" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Activity Log"
                                   Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ListBox x:Name="ActivityLogList" ItemsSource="{Binding ActivityLog}" Background="#18212A"
                                 Foreground="#D9E2EC" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="DLNG Report Summary"
                                   Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DataGrid ItemsSource="{Binding SummaryRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="#F8FAFC" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Section" Binding="{Binding DatasetSection}" Width="145"/>
                                <DataGridTextColumn Header="Line" Binding="{Binding LinePolarity}" Width="70"/>
                                <DataGridTextColumn Header="Folder" Binding="{Binding CropFolder}" Width="105"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceClass}" Width="115"/>
                                <DataGridTextColumn Header="Final" Binding="{Binding FinalClass}" Width="130"/>
                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60"/>
                                <DataGridTextColumn Header="Switch" Binding="{Binding SwitchedCount}" Width="65"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" Margin="0,0,10,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="DLNG Review Queue" FontSize="16" FontWeight="SemiBold"/>
                        </Border>
                        <DataGrid Sorting="ReworkGrid_Sorting" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="ToolTip" Value="{Binding ImageState}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"><Setter Property="IsHitTestVisible" Value="False"/></DataTrigger>
                                        <DataTrigger Binding="{Binding JudgmentTone}" Value="Real">
                                            <Setter Property="Background" Value="#D9EAD3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding JudgmentTone}" Value="Overkill"><Setter Property="Background" Value="#F4CCCC"/></DataTrigger>
                                        <DataTrigger Binding="{Binding ReviewStatus}" Value="Save failed">
                                            <Setter Property="Background" Value="#FFE5A3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="78" SortMemberPath="InspectionTime"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="62" SortMemberPath="InspectionTime"/>
                                <DataGridTextColumn Header="Line" Binding="{Binding LinePolarity}" Width="54"/>
                                <DataGridTextColumn Header="Cell-ID" Binding="{Binding CellId}" Width="92"/>
                                <DataGridTextColumn Header="Rework" Binding="{Binding ReworkLabel}" Width="52"/>
                                <DataGridTextColumn Header="Judge" Binding="{Binding Judge}" Width="48"/>
                                <DataGridTextColumn Header="Defect" Binding="{Binding Defect}" Width="83"/>
                                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="52"/>
                                <DataGridTextColumn Header="Final Class" Binding="{Binding SavedClass}" Width="85"/>
                                <DataGridTextColumn Header="Review" Binding="{Binding ReviewStatus}" Width="65"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="#111820" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#EEF1F4" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPreview.Label}"
                                               Foreground="#243B53" FontWeight="SemiBold"/>
                                    <TextBlock Text="  |  " Foreground="#829AB1"/>
                                    <TextBlock Text="{Binding ImagePositionText}" Foreground="#52606D"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="&#9873;"
                                        Command="{Binding FlagCommand}"
                                        MinWidth="32"
                                        Padding="8,2"
                                        ToolTip="Flag this cell for follow-up"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="ImageScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          PanningMode="Both"
                                          CanContentScroll="False"
                                          PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                                          PreviewMouseLeftButtonDown="ImageScrollViewer_PreviewMouseLeftButtonDown"
                                          PreviewMouseLeftButtonUp="ImageScrollViewer_PreviewMouseLeftButtonUp"
                                          PreviewMouseMove="ImageScrollViewer_PreviewMouseMove"
                                          LostMouseCapture="ImageScrollViewer_LostMouseCapture"
                                          Cursor="Hand"
                                          Background="#111820">
                                <Grid MinWidth="200" MinHeight="200">
                                    <Image x:Name="ReviewImage"
                                           Source="{Binding CurrentPreview.Image, NotifyOnTargetUpdated=True}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TargetUpdated="ReviewImage_TargetUpdated">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="10" Padding="8,5" Background="#CC111820"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding DisplayOverlay}" Foreground="White"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   MaxWidth="420"/>
                                    </Border>
                                    <TextBlock Text="{Binding CurrentPreview.State}"
                                               Foreground="#D9E2EC" FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </ScrollViewer>
                            <Border Grid.Row="1" Background="#18212A" Padding="8">
                                <Grid>
                                    <TextBlock Text="Drag or scroll: pan   Ctrl + scroll: zoom at pointer"
                                               Foreground="#9FB3C8" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="ZoomText" Text="60%"
                                               Foreground="White" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="MinHeight" Value="27"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="#BCCCDC"/>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="Final Class" ToolTip="Segmentation: R = Real, O = Overkill, N = Not DLNG" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <CheckBox Content="Auto advance" IsChecked="{Binding AutoAdvanceAfterReview}" Margin="2,0,0,8"/>
                            <CheckBox Content="Always save" IsChecked="{Binding AlwaysSave}" ToolTip="Default training inclusion for new reviews. You can uncheck an individual item." Margin="2,0,0,6"/>
                            <CheckBox Content="Include in training dataset (T)" IsChecked="{Binding IncludeInTraining}" IsEnabled="{Binding CanCollect}" Margin="2,4,0,10"/>
                            <ItemsControl ItemsSource="{Binding FinalClassOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Save selection (Enter)"
                                    Command="{Binding CommitCommand}"
                                    Margin="2,6,2,8"
                                    Padding="8,5"/>
                            <Separator/>
                            <TextBlock Text="DLNG Item" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,8"/>
                            <TextBlock Text="Cell ID" Foreground="#52606D"/>
                            <TextBlock Text="{Binding SelectedCandidate.CellId}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="Judge / Defect" Foreground="#52606D"/>
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="{Binding SelectedCandidate.Judge, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding SelectedCandidate.Defect, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="Crop folder" Foreground="#52606D"/>
                            <TextBlock Text="{Binding SelectedCandidate.CropFolder}" FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Source class" Foreground="#52606D"/>
                            <TextBlock Text="{Binding SelectedCandidate.SourceClass}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="Review" Foreground="#52606D"/>
                            <TextBlock Text="{Binding SelectedCandidate.ReviewStatus}" FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <Separator/>
                            <TextBlock Text="Image Navigation" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <UniformGrid Columns="2">
                                <Button Content="Left: Previous" Command="{Binding PreviousImageCommand}"/>
                                <Button Content="Right: Next" Command="{Binding NextImageCommand}"/>
                            </UniformGrid>
                            <TextBlock Text="Cell Navigation" FontWeight="SemiBold" Margin="0,10,0,4"/>
                            <UniformGrid Columns="2">
                                <Button Content="Up: Previous" Command="{Binding PreviousCommand}"/>
                                <Button Content="Down: Next" Command="{Binding NextCommand}"/>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

