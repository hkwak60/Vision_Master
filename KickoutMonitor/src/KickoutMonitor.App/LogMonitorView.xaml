<UserControl x:Class="KickoutMonitor.App.LogMonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F3F5F7">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackground}" Padding="18,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Back" Click="BackButton_Click" Margin="0,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="LOG Monitor" Foreground="White" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Retry frequency by date and electrode" Foreground="#C8D1DA" FontSize="12"/></StackPanel><Button Grid.Column="2" Content="Select Log Files" Click="SelectFilesButton_Click"/><Button x:Name="ExportButton" Grid.Column="3" Content="Export CSV" Click="ExportButton_Click" IsEnabled="False"/></Grid></Border>
    <StatusBar DockPanel.Dock="Bottom" Background="#E1E5E9"><TextBlock x:Name="StatusText" Text="Select one or more .log files to analyze."/></StatusBar>
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#18212A" BorderBrush="#354553" BorderThickness="1" Padding="10" Margin="0,0,0,10"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Activity Log" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,5"/><ListBox x:Name="ActivityLogList" ItemsSource="{Binding ActivityLog}" Background="#18212A" Foreground="#DCE5EC" BorderThickness="0" FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto"/></DockPanel></Border>
      <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Retry Frequency" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FilesText" Text="No files selected" Foreground="#52606D" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Margin="18,0"><TextBlock Text="Total" Foreground="#52606D" HorizontalAlignment="Center"/><TextBlock x:Name="InstanceCountText" Text="0" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="2" Margin="18,0"><TextBlock Text="Anode" Foreground="#B45309" HorizontalAlignment="Center"/><TextBlock x:Name="AnodeCountText" Text="0" Foreground="#B45309" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="3" Margin="18,0"><TextBlock Text="Cathode" Foreground="#2563A6" HorizontalAlignment="Center"/><TextBlock x:Name="CathodeCountText" Text="0" Foreground="#2563A6" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="4" Margin="18,0"><TextBlock Text="Reached 4" Foreground="#B91C1C" HorizontalAlignment="Center"/><TextBlock x:Name="ReachedFourCountText" Text="0" Foreground="#B91C1C" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
      <DataGrid x:Name="ResultsGrid" Grid.Row="2" ItemsSource="{Binding ResultsView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" MinColumnWidth="110">
        <DataGrid.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" Margin="0,8,0,2"><Expander.Header><Border Background="#DCE3E8" Padding="12,9"><DockPanel MinWidth="650"><TextBlock Text="{Binding Name, StringFormat={}{0:dddd, MMMM d, yyyy}}" FontSize="15" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount, StringFormat={}{0} retry instances}" Foreground="#52606D" Margin="24,0,0,0"/></DockPanel></Border></Expander.Header><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></DataGrid.GroupStyle>
        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Style.Triggers><DataTrigger Binding="{Binding Side}" Value="Anode"><Setter Property="Background" Value="#FFF4E5"/></DataTrigger><DataTrigger Binding="{Binding Side}" Value="Cathode"><Setter Property="Background" Value="#EAF4FF"/></DataTrigger><DataTrigger Binding="{Binding ReachedFour}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
        <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="170" MinWidth="150"/><DataGridTextColumn Header="Electrode" Binding="{Binding Side}" Width="140" MinWidth="120"/><DataGridTextColumn Header="Retry Count" Binding="{Binding MaximumCount}" Width="130" MinWidth="120"/><DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="140" MinWidth="120"/><DataGridTextColumn Header="Log File" Binding="{Binding FileName}" Width="*" MinWidth="320"/></DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
